#include <windows.h>

#define QLIC_VERSION_COMMAS @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define QLIC_VERSION_TEXT "@PROJECT_VERSION@.0"

#ifdef QLIC_RESOURCE_DLL
#define QLIC_FILE_TYPE VFT_DLL
#else
#define QLIC_FILE_TYPE VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION QLIC_VERSION_COMMAS
 PRODUCTVERSION QLIC_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE QLIC_FILE_TYPE
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "QLIC Project\0"
      VALUE "FileDescription", "@QLIC_FILE_DESCRIPTION@\0"
      VALUE "FileVersion", QLIC_VERSION_TEXT "\0"
      VALUE "InternalName", "@QLIC_INTERNAL_NAME@\0"
      VALUE "OriginalFilename", "@QLIC_ORIGINAL_FILENAME@\0"
      VALUE "LegalCopyright", "Copyright 2026 Ozzy M.\0"
      VALUE "ProductName", "QLIC\0"
      VALUE "ProductVersion", QLIC_VERSION_TEXT "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
